# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
COLLISION_CANARY_BASE_URL=http://localhost:3000

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Actor-token signing
LAB_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Optional non-interactive Kane authentication
TESTMU_USERNAME=
TESTMU_ACCESS_KEY=

# Optional non-standard Chrome installation
KANE_CLI_CHROME_PATH=/usr/bin/google-chrome
